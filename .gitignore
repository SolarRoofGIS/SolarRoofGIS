# Raw source data, archives, project documents, and local PostgreSQL data stay outside Git.
/ref/
/docs/
/.postgres-data/

# Large building data and local processing products stay outside Git: everything in
# data_bogor except the small Global Solar Atlas rasters the backend reads.
/data_bogor/*
!/data_bogor/photovoltaic/
/data_bogor/photovoltaic/**/*.aux.xml

# JavaScript build and local configuration.
/frontend/node_modules/
/frontend/build/
# Copied from node_modules by `npm start` / `npm run build` (see frontend/package.json).
/frontend/public/maplibre-gl-worker.mjs
/frontend/.next/
/frontend/out/
/frontend/.vercel/
/backend/node_modules/
/backend/.env
/backend/.next/
/ref/tools/webmap/node_modules/
/ref/tools/webmap/dist/
**/.env
**/.env.*
!**/.env.example
**/.pgpass

# Python and operating-system generated files.
**/__pycache__/
*.py[cod]
.DS_Store
